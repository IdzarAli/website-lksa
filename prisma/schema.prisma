// Schema LKSA Danukusumo (sesuai spesifikasi §6)
// Kontrak model dijaga tetap agar mudah dipindah ke produksi (Django + PostgreSQL / Supabase).
// Catatan SQLite: field "String" yang berisi JSON disimpan sebagai string JSON
// (SQLite tidak punya tipe Json di Prisma; di PostgreSQL nanti bisa dipetakan ke JsonB).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ KONTEN PUBLIK ============

// Berita/artikel. Status: draf | menunggu-persetujuan | terbit | ditarik
model Article {
  id                 String    @id @default(cuid())
  slug               String    @unique
  judul              String
  ringkasan          String
  isi                String
  kategori           String
  mediaUrl           String?
  mediaAlt           String?
  publicationConsent Boolean   @default(false)
  publishedAt        DateTime?
  status             String    @default("draf")
  createdAt          DateTime  @default(now())
}

// Pengumuman singkat di halaman Informasi. Status sama seperti Article.
model Announcement {
  id          String    @id @default(cuid())
  judul       String
  isi         String
  kategori    String
  prioritas   String // biasa | penting
  publishedAt DateTime?
  status      String    @default("draf")
  createdAt   DateTime  @default(now())
}

// Statistik agregat lembaga (INV-3: hanya agregat, tanpa data individu anak).
// Field JSON disimpan sebagai String.
model InstitutionStats {
  id                String    @id @default(cuid())
  periode           String
  usiaAgregat       String // JSON
  pendidikanAgregat String // JSON
  alokasi           String // JSON
  sumber            String
  approvedBy        String?
  createdAt         DateTime  @default(now())
}

// Pengasuh. Yang tampil publik hanya yang status terbit + publicationConsent.
model Staff {
  id                 String   @id @default(cuid())
  nama               String
  peran              String
  foto               String?
  publicationConsent Boolean  @default(false)
  status             String   @default("draf")
}

// ============ DONASI (INV-1) ============
// Transfer bank/QRIS terjadi di luar website. Website hanya menyimpan
// KONFIRMASI yang kemudian diverifikasi manual oleh petugas berwenang (INV-5).

model DonationConfirmation {
  id                String    @id @default(cuid())
  referensi         String    @unique
  idempotencyKey    String    @unique
  nama              String
  email             String
  wa                String
  nominalRupiah     Int // integer rupiah, tanpa desimal
  keterangan        String?
  receiptKey        String // nama acak berkas bukti; berkas di luar folder publik (INV-4)
  consentAt         DateTime
  leaderboardConsent Boolean @default(false) // pilihan terpisah & opsional, default TIDAK ditampilkan
  status            String    @default("menunggu-verifikasi")
  // menunggu-verifikasi -> terverifikasi | perlu-perbaikan | ditolak (transisi lain ditolak server)
  verifiedBy        String?
  verifiedAt        DateTime?
  keputusanAlasan   String?
  version           Int       @default(1) // pemeriksaan versi agar dua petugas tidak saling menimpa
  createdAt         DateTime  @default(now())
}

// ============ PERSEWAAN (INV-2) ============
// Hanya PERMOHONAN, bukan booking. Tanpa pembayaran, tidak mengunci jadwal.

model RentalItem {
  id          String @id @default(cuid())
  nama        String
  jenis       String // aula | kursi | tenda
  satuan      String
  tarifContoh Int // tarif berlabel CONTOH (OD-05)
  tambahan    String // JSON rincian tambahan sesuai jenis
  status      String @default("draf")
}

model RentalRequest {
  id               String   @id @default(cuid())
  referensi        String   @unique
  idempotencyKey   String   @unique
  rentalItemId     String
  penyewa          String
  kontak           String
  alamat           String
  jadwal           String // JSON {mulai, selesai}
  rincianJenis     String // JSON rincian sesuai jenis (kolom kondisional)
  estimasiSnapshot String // JSON hasil hitung ulang DI SERVER (jangan percaya browser)
  status           String   @default("diajukan")
  // diajukan -> ditinjau -> disetujui | perlu-perbaikan | ditolak (transisi lain ditolak server)
  keputusanAlasan  String?
  version          Int      @default(1)
  createdAt        DateTime @default(now())
}

// ============ AUDIT, NOTIFIKASI, AKUN ============

// Jejak audit TANPA isi bukti/PII (hanya aksi + entitas + keputusan).
model AuditEvent {
  id             String   @id @default(cuid())
  actorId        String?
  aksi           String
  entityType     String
  entityId       String
  perubahanStatus String?
  waktu          DateTime @default(now())
}

// Notifikasi di dashboard admin untuk pengajuan baru.
model Notification {
  id         String    @id @default(cuid())
  jenis      String // donasi | persewaan
  entityType String
  entityId   String
  referensi  String
  createdAt  DateTime  @default(now())
  dibacaOleh String?
  dibacaAt   DateTime?
}

// Catatan percobaan pengiriman pesan keluar (kanal WA/email = mock, default mati, OD-10/OD-11).
model NotificationDelivery {
  id             String    @id @default(cuid())
  notificationId String
  kanal          String // dashboard | wa | email
  penerima       String
  status         String    @default("antri") // antri | terkirim | gagal
  percobaan      Int       @default(0)
  errorRingkas   String?
  sentAt         DateTime?
}

// Akun admin demo sintetis. role: editor | verifikator | pengelola
// WAJIB GANTI SEBELUM PRODUKSI.
model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  nama         String
  role         String
  passwordHash String // format: scrypt:<saltHex>:<hashHex>
}

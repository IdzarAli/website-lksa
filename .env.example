# Konfigurasi Django (backend)
DJANGO_SECRET_KEY=dev-only-ganti-di-produksi
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN_HOSTS=localhost,127.0.0.1
SESSION_COOKIE_SECURE=False
NOTIFY_ENABLED=False

# Alamat backend Django untuk proxy /api/* di Next.js
DJANGO_API_URL=http://127.0.0.1:8000

# ── Produksi (aktifkan saat deploy) ──────────────────────────────
# DJANGO_SECRET_KEY=<kunci-acak-min-50-karakter>
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=danukusumo.or.id,www.danukusumo.or.id
# FRONTEND_ORIGIN_HOSTS=danukusumo.or.id
# CSRF_TRUSTED_ORIGINS=https://danukusumo.or.id,https://www.danukusumo.or.id
# SESSION_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# TRUSTED_PROXY_IPS=127.0.0.1

{
  "name": "lksa-danukusumo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "next dev -p 3000",
    "dev:api": "cd backend && npm run dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint src scripts eslint.config.mjs next.config.ts postcss.config.mjs",
    "setup": "cd backend && npm install",
    "seed": "cd backend && node src/seed.js",
    "seed:reset": "cd backend && node src/seed.js --reset",
    "test:backend": "cd backend && npm test"
  },
  "dependencies": {
    "framer-motion": "^12.23.2",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
